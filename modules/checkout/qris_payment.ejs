<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pembayaran QRIS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f5f5fa; padding: 20px; min-height: 100vh; }
        .container { max-width: 800px; margin: 0 auto; }

        .qris-card {
            background: white; border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 40px; margin-top: 40px; text-align: center;
        }

        .qris-header { margin-bottom: 30px; }
        .qris-header h1 { font-size: 24px; color: #2c3e50; margin-bottom: 8px; }
        .qris-header p { color: #7f8c8d; font-size: 14px; }

        .qris-image-container {
            background: #f8f9fa; border-radius: 12px;
            padding: 30px; display: inline-block; margin-bottom: 24px;
            border: 2px dashed #dee2e6;
        }
        .qris-image-container img {
            max-width: 280px; height: auto; display: block;
        }
        .qris-image-container.empty {
            padding: 50px 40px;
        }
        .qris-image-container.empty i {
            font-size: 80px; color: #bdc3c7; margin-bottom: 16px;
        }
        .qris-image-container.empty p {
            color: #95a5a6; font-size: 14px;
        }

        .order-info {
            background: #f8f9fa; border-radius: 8px; padding: 20px;
            margin-bottom: 24px; text-align: left;
        }
        .info-row {
            display: flex; justify-content: space-between; padding: 8px 0;
            border-bottom: 1px solid #e9ecef; font-size: 14px;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #7f8c8d; }
        .info-value { font-weight: 600; color: #2c3e50; }
        .info-value.total { color: #27ae60; font-size: 18px; }

        .status-area { margin: 24px 0; }
        .status-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 24px; border-radius: 24px; font-weight: 600;
            font-size: 14px;
        }
        .status-badge.pending {
            background: #fff3cd; color: #856404;
        }
        .status-badge.success {
            background: #d4edda; color: #155724;
        }
        .status-badge.expired {
            background: #f8d7da; color: #721c24;
        }
        .status-badge i { font-size: 16px; }

        .timer-container { margin: 16px 0; }
        .timer-container .label { color: #7f8c8d; font-size: 13px; margin-bottom: 4px; }
        .timer { font-size: 28px; font-weight: 700; color: #e74c3c; letter-spacing: 2px; }
        .timer.expired { color: #7f8c8d; }

        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 32px; border: none; border-radius: 8px;
            font-size: 15px; font-weight: 600; cursor: pointer;
            transition: all 0.2s;
        }
        .btn-check {
            background: #3498db; color: white;
        }
        .btn-check:hover { background: #2980b9; }
        .btn-check:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-home {
            background: #ecf0f1; color: #2c3e50; text-decoration: none;
        }
        .btn-home:hover { background: #dfe6e9; }

        .success-message {
            background: #d4edda; border: 1px solid #c3e6cb;
            border-radius: 8px; padding: 20px; margin-top: 20px;
            color: #155724;
        }
        .success-message h3 { margin-bottom: 8px; }
        .success-message p { font-size: 14px; }

        .expired-message {
            background: #f8d7da; border: 1px solid #f5c6cb;
            border-radius: 8px; padding: 20px; margin-top: 20px;
            color: #721c24;
        }
        .expired-message h3 { margin-bottom: 8px; }
        .expired-message p { font-size: 14px; }

        .loading-spinner {
            display: inline-block; width: 20px; height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-top: 3px solid white; border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .created-at { color: #7f8c8d; font-size: 12px; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="qris-card">
            <div class="qris-header">
                <h1><i class="fas fa-qrcode" style="color:#2c3e50;"></i> Pembayaran QRIS</h1>
                <p>Scan QRIS ini menggunakan aplikasi e-wallet atau mobile banking Anda</p>
            </div>

            <div id="qrisImageContainer" class="qris-image-container empty">
                <i class="fas fa-spinner fa-pulse"></i>
                <p>Memuat QRIS...</p>
            </div>

            <div class="timer-container">
                <div class="label"><i class="far fa-clock"></i> Sisa waktu pembayaran</div>
                <div class="timer" id="timerDisplay">--:--</div>
            </div>

            <div class="order-info">
                <div class="info-row">
                    <span class="info-label">Invoice</span>
                    <span class="info-value" id="invoiceDisplay">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Produk</span>
                    <span class="info-value" id="productDisplay">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Jumlah</span>
                    <span class="info-value" id="qtyDisplay">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Subtotal</span>
                    <span class="info-value" id="subtotalDisplay">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Diskon</span>
                    <span class="info-value" id="discountDisplay">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Kode Unik</span>
                    <span class="info-value" id="kodeUnikDisplay">-</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Total</span>
                    <span class="info-value total" id="totalDisplay">-</span>
                </div>
            </div>

            <div class="status-area">
                <div class="status-badge pending" id="statusBadge">
                    <i class="fas fa-hourglass-half"></i>
                    <span>Menunggu Pembayaran</span>
                </div>
            </div>

            <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:16px;">
                <button class="btn btn-check" id="checkStatusBtn">
                    <i class="fas fa-sync-alt"></i> Cek Status Pembayaran
                </button>
                <a href="/" class="btn btn-home">
                    <i class="fas fa-arrow-left"></i> Kembali ke Beranda
                </a>
            </div>

            <div id="successMessage" class="success-message" style="display:none;">
                <h3><i class="fas fa-check-circle"></i> Pembayaran Berhasil!</h3>
                <p>Pembayaran Anda telah dikonfirmasi. Anda akan dialihkan ke halaman detail pesanan...</p>
            </div>

            <div id="expiredMessage" class="expired-message" style="display:none;">
                <h3><i class="fas fa-exclamation-triangle"></i> Waktu Pembayaran Habis</h3>
                <p>Pesanan ini telah kadaluarsa. Silakan lakukan pemesanan ulang.</p>
            </div>

            <div class="created-at" id="createdAtDisplay"></div>
        </div>
    </div>

    <script>
        (function() {
            const paymentData = (function() {
                try {
                    const stored = sessionStorage.getItem('paymentResult');
                    return stored ? JSON.parse(stored) : null;
                } catch(e) { return null; }
            })();

            if (!paymentData) {
                document.body.innerHTML = '<div class="container"><div class="qris-card"><h2>Data pembayaran tidak ditemukan</h2><p style="margin:16px 0;color:#7f8c8d;">Silakan lakukan pemesanan ulang.</p><a href="/" class="btn btn-home"><i class="fas fa-arrow-left"></i> Kembali ke Beranda</a></div></div>';
                return;
            }

            const orderId = paymentData.orderId;
            const qrisUrl = paymentData.qris_url;
            const qrisImage = paymentData.qris_image;
            const qrisExpiredAt = paymentData.qris_expired_at;

            // Display order info
            document.getElementById('invoiceDisplay').textContent = paymentData.invoiceNumber || '-';
            document.getElementById('productDisplay').textContent = paymentData.productName || '-';
            document.getElementById('qtyDisplay').textContent = paymentData.quantity || '-';

            const fmt = (num) => 'Rp' + parseInt(num || 0).toLocaleString('id-ID');
            document.getElementById('subtotalDisplay').textContent = fmt(paymentData.subtotal);
            document.getElementById('discountDisplay').textContent = '-' + fmt(paymentData.discount);
            document.getElementById('kodeUnikDisplay').textContent = '-' + fmt(paymentData.kodeUnik);
            document.getElementById('totalDisplay').textContent = fmt(paymentData.totalPrice);
            document.getElementById('createdAtDisplay').textContent = 'Batas pembayaran: ' + (paymentData.paymentDeadline || '-');

            // Display QRIS image
            const qrisContainer = document.getElementById('qrisImageContainer');
            if (qrisImage && qrisImage.startsWith('data:image')) {
                qrisContainer.classList.remove('empty');
                qrisContainer.innerHTML = '<img src="' + qrisImage + '" alt="QRIS Code" />';
            } else if (qrisUrl) {
                qrisContainer.classList.remove('empty');
                qrisContainer.innerHTML = '<img src="' + qrisUrl + '" alt="QRIS Code" />';
            } else {
                qrisContainer.classList.remove('empty');
                qrisContainer.innerHTML = '<div style="padding:30px;"><i class="fas fa-qrcode" style="font-size:80px;color:#bdc3c7;"></i><p style="margin-top:12px;color:#95a5a6;">QRIS akan tersedia setelah konfigurasi API</p></div>';
            }

            // Timer
            const timerEl = document.getElementById('timerDisplay');
            let expired = false;

            function updateTimer() {
                if (!qrisExpiredAt) {
                    timerEl.textContent = '--:--';
                    timerEl.classList.remove('expired');
                    return;
                }
                const now = new Date().getTime();
                const end = new Date(qrisExpiredAt.replace(' ', 'T')).getTime();
                const diff = end - now;

                if (diff <= 0) {
                    timerEl.textContent = '00:00';
                    timerEl.classList.add('expired');
                    expired = true;
                    return;
                }

                const minutes = Math.floor(diff / 60000);
                const seconds = Math.floor((diff % 60000) / 1000);
                timerEl.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
                timerEl.classList.remove('expired');
            }

            updateTimer();
            setInterval(updateTimer, 1000);

            // Status polling
            const statusBadge = document.getElementById('statusBadge');
            const checkBtn = document.getElementById('checkStatusBtn');
            const successMsg = document.getElementById('successMessage');
            const expiredMsg = document.getElementById('expiredMessage');
            let pollInterval = null;
            let paid = false;

            async function checkStatus() {
                if (paid) return;

                checkBtn.disabled = true;
                checkBtn.innerHTML = '<span class="loading-spinner"></span> Mengecek...';

                try {
                    const response = await fetch('/qris-status/' + orderId);
                    const result = await response.json();

                    if (result.status === 'success') {
                        const orderStatus = result.data.order_status;
                        const qrisStatus = result.data.qris_status;

                        if (orderStatus === 'paid' || qrisStatus === 'SUCCESS') {
                            paid = true;
                            statusBadge.className = 'status-badge success';
                            statusBadge.innerHTML = '<i class="fas fa-check-circle"></i><span>Pembayaran Berhasil</span>';

                            successMsg.style.display = 'block';

                            if (pollInterval) {
                                clearInterval(pollInterval);
                                pollInterval = null;
                            }

                            setTimeout(function() {
                                window.location.href = '/thankyou';
                            }, 3000);
                        } else if (qrisStatus === 'EXPIRED' || expired) {
                            statusBadge.className = 'status-badge expired';
                            statusBadge.innerHTML = '<i class="fas fa-times-circle"></i><span>Kadaluarsa</span>';

                            expiredMsg.style.display = 'block';

                            if (pollInterval) {
                                clearInterval(pollInterval);
                                pollInterval = null;
                            }
                        } else {
                            statusBadge.className = 'status-badge pending';
                            statusBadge.innerHTML = '<i class="fas fa-hourglass-half"></i><span>Menunggu Pembayaran</span>';
                        }
                    }
                } catch (error) {
                    console.error('Status check error:', error);
                } finally {
                    checkBtn.disabled = false;
                    checkBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Cek Status Pembayaran';
                }
            }

            checkBtn.addEventListener('click', checkStatus);

            // Auto-poll every 10 seconds
            pollInterval = setInterval(checkStatus, 10000);
        })();
    </script>
</body>
</html>
